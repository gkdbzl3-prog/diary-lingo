{
  "name": "diary-lingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "한국어 일기를 외국어 학습 자료로 바꿔 주는 개인용 도구",
  "scripts": {
    "translate": "node --env-file-if-exists=.env src/cli.js",
    "split": "node src/split.js",
    "import-out": "node src/import-out.js",
    "server": "node --env-file-if-exists=.env src/server.js",
    "web": "vite",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
